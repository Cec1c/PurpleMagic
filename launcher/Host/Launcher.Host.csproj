<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DNF90.Core</AssemblyName><Version>1.0.6</Version>
    <Product>PurpleMagic</Product><Title>PurpleMagic</Title><Description>PurpleMagic</Description>
    <PublishAot>true</PublishAot><InvariantGlobalization>false</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <LauncherInput Condition="'$(LauncherInput)'==''">$(MSBuildThisFileDirectory)..\..\runtime\launcher-input</LauncherInput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine\Launcher.Engine.csproj"/>
    <EmbeddedResource Include="$(LauncherInput)\profile.json" LogicalName="profile.json"/>
  </ItemGroup>
</Project>
